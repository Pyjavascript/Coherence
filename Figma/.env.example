# Public values only. The plugin reads the repo root .env first (VITE_SUPABASE_URL,
# VITE_SUPABASE_ANON_KEY — the same values the web app uses), then this file,
# which wins where both set a value.
#
# NEVER put OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY or any sb_secret_ key here:
# everything below ends up inside the plugin bundle. `npm run build` fails if it
# finds one.

# Only needed if you want different values from the root .env.
# VITE_SUPABASE_URL=https://YOURREF.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Where "Open full app" points (https only). Leave empty to hide the link.
VITE_BLOS_WEB_URL=

# Plugin id written into manifest.json. Figma assigns real ids; for local
# development any stable string works. If Figma refuses to import it, create a
# plugin once via Plugins > Development > New plugin… and paste its id here.
FIGMA_PLUGIN_ID=brand-language-os-local
